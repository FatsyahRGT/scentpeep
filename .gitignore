# ==========================================
# 1. Environment & Sensitive Credentials
# ==========================================
.env
.env.*
!.env.example
!.env.docker.example
auth.json
*.pem
*.key
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*
credentials*.json
client_secret*.json

# ==========================================
# 2. Personal, Financial & Raw Data Files
# (Mencegah kebocoran data transaksi/keuangan)
# ==========================================
*.csv
*.xlsx
*.xls
*.tsv
*.sql
*.sql.gz
*.sqlite
*.sqlite-journal
*.db
*.dump
/storage/app/exports/*
/storage/app/imports/*

# ==========================================
# 3. Logs, Debug & Cache
# ==========================================
*.log
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
.phpunit.result.cache
/.phpunit.cache

# ==========================================
# 4. Storage & Uploads
# ==========================================
/public/storage
/public/build
/public/hot
/public/fonts-manifest.dev.json
/storage/*.key
/storage/pail
/storage/app/public/*
!/storage/app/public/.gitignore

# ==========================================
# 5. Dependency Directories
# ==========================================
/vendor
/node_modules

# ==========================================
# 6. IDEs, Editors & OS Metadata
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
/.idea
/.vscode/*
!/.vscode/settings.json
/.cursor/
/.zed
/.nova
/.codex
.phpactor.json
_ide_helper.php
Homestead.json
Homestead.yaml

# Backup and temp files
*.bak
*.tmp
*.temp
*.swp
*.swo
*~
