# ==========================================
# Scentpeep Management System - Docker Environment
# ==========================================

# Port Configuration (Bisa disesuaikan dengan kebutuhan server Anda)
HTTP_PORT=80
# DB_PORT=3306 # Biarkan kosong atau tidak diekspos ke publik jika database hanya untuk internal container

# Nginx Security Version (Pinned to patched security release)
# Mainline: >= 1.31.7 | Stable: >= 1.30.6
NGINX_IMAGE=nginx:1.31.7-alpine

# MySQL Database Configuration
DB_DATABASE=scentpeep
DB_USERNAME=scentpeep_user
DB_PASSWORD=GantiDenganPasswordKuatDanAcak123!
DB_ROOT_PASSWORD=GantiDenganRootPasswordSangatKuat456!

# Laravel Application
APP_NAME=Scentpeep
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=base64:GENERATE_NEW_KEY_DENGAN_ARTISAN
