# ================================================================
# Scentpeep Management System - Docker Environment (VPS Production)
# ================================================================

# Multi-App Host Ports (Diselaraskan dengan port VPS Anda)
HTTP_PORT=8082
DB_PORT=3308

# Nginx Security Version (Mainline >= 1.31.7 / Stable >= 1.30.6)
NGINX_IMAGE=nginx:1.31.7-alpine

# Database Credentials
DB_DATABASE=scentpeep
DB_USERNAME=scentpeep_user
DB_PASSWORD=your_secure_database_password_here
DB_ROOT_PASSWORD=your_secure_root_password_here

# Laravel Application
APP_NAME=Scentpeep
APP_ENV=production
APP_DEBUG=false
APP_URL=http://scentpeep-management-system.duckdns.org:8082
# APP_KEY di-generate otomatis oleh entrypoint jika kosong, atau jalankan: docker compose exec app php artisan key:generate
APP_KEY=
